{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Personal portfolio site for a cloud & DevOps engineer.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "site"
  ],
  "scripts": {
    "dev": "npm run dev --workspace site",
    "build": "npm run build --workspace site",
    "headers": "node scripts/gen-headers.mjs",
    "headers:check": "node scripts/gen-headers.mjs --check",
    "preview": "node scripts/preview.mjs",
    "sprites": "node scripts/gen-placeholder-sprites.mjs",
    "check": "npm run check --workspace site",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"infra/**/*.test.mjs\" \"scripts/**/*.test.mjs\" && npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript-eslint": "^8.71.2"
  }
}
