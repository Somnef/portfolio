{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Personal portfolio site for a cloud & DevOps engineer.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "site"
  ],
  "scripts": {
    "dev": "npm run dev --workspace site",
    "build": "npm run build --workspace site",
    "check": "npm run check --workspace site",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1"
  }
}
