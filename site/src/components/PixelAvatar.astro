---
/*
 * Decorative only: aria-hidden and pointer-events: none, so it is invisible to
 * assistive technology and cannot intercept a click. Nothing depends on it -
 * delete the sprite PNGs and the site is unaffected, the element just paints
 * no background.
 *
 * Deliberately no `define:vars` and no inline style attribute. CSP style-src
 * governs style attributes as well as <style> elements (PLAN.md 3.5c), and
 * define:vars compiles to exactly such an attribute. The defaults below
 * mirror site/src/config/avatar.json; the island overrides them from that file
 * at runtime, which is what lets a config change take effect without touching
 * CSS.
 *
 * Two nested elements on purpose: the outer one owns position, the inner one
 * owns the mirror. Mixing both on a single element is what broke the
 * scroll-up direction once already - see the comment on .sprite.
 */
---

<div class="avatar-anchor" aria-hidden="true">
  <div class="avatar" data-avatar data-mode="idle" data-facing="down">
    <div class="sprite"></div>
  </div>
</div>

<style>
  /*
   * A zero-height sticky anchor: it occupies no layout space, so it cannot
   * push content around, and it sticks only while the journey is on screen
   * because a sticky element is bounded by its containing block.
   */
  .avatar-anchor {
    position: sticky;
    inset-block-start: 38vh;
    block-size: 0;
    pointer-events: none;

    /*
     * Deliberately no z-index. The anchor precedes the entries in the DOM, so
     * entry text paints over the sprite rather than under it. The geometry
     * should keep them apart anyway, but this is decorative art and readable
     * content wins any argument between them - defence in depth for exactly
     * the overlap bug the facing-up transform caused.
     */
  }

  /*
   * Position only. Never transformed, so nothing can move it sideways.
   *
   * The sprite walks alongside the rail, not over it: translate: -100% puts
   * its trailing edge on the offset point, and the offset is the line's
   * position pulled back by --avatar-gap. So the gap is measured from the
   * line to the edge of the sprite box, and the line - and the entry dots
   * sitting on it - stay visible at every breakpoint.
   */
  .avatar {
    /* Defaults mirroring avatar.json, used before (or without) script. */
    --frame-w: 32px;
    --frame-h: 32px;
    --sprite-frames: 1;
    --sprite-duration: 1200ms;
    --sprite-sheet: url('/sprites/default/idle.png');

    position: absolute;
    /* Measured off the rail line - which is why the rail width is one shared
       custom property rather than a number copied between components. */
    inset-inline-start: calc(var(--rail-width) / 2 - var(--avatar-gap));
    translate: -100% 0;

    inline-size: calc(var(--frame-w) * var(--avatar-scale));
    block-size: calc(var(--frame-h) * var(--avatar-scale));
  }

  /*
   * Paint and mirror only, inside the box the parent positions.
   *
   * The mirror lives here rather than on .avatar because scale: -1 flips an
   * element about its own centre and so does NOT move it - which means the
   * offset above needs no compensation. A previous version "corrected" for
   * the flip by flipping the translate's sign, which shifted the sprite a
   * full sprite width to the right, over the text, every time the reader
   * scrolled up. Keeping position and mirror on separate elements makes that
   * class of mistake impossible rather than merely fixed.
   */
  .sprite {
    inline-size: 100%;
    block-size: 100%;

    /* Nearest-neighbour: anything else turns pixel art into mush. */
    image-rendering: pixelated;

    background-image: var(--sprite-sheet);
    background-repeat: no-repeat;
    background-position: 0 0;
    background-size: calc(var(--frame-w) * var(--avatar-scale) * var(--sprite-frames)) 100%;
  }

  /* The art is drawn facing right and mirrored for upward movement, so only
     one set of sheets is ever needed. */
  .avatar[data-facing='up'] .sprite {
    scale: -1 1;
  }

  /*
   * With --sprite-frames at its default of 1 this is a no-op, so no script
   * means a single static frame. Under reduced motion the animation is never
   * declared at all, and the island never switches to the walk sheet.
   */
  @media (prefers-reduced-motion: no-preference) {
    .sprite {
      animation: sprite var(--sprite-duration) steps(var(--sprite-frames)) infinite;
    }
  }

  /*
   * steps() with the default jump-end lands on each frame in turn and never
   * reaches the end position, which is why this travels the full sheet width
   * rather than stopping a frame short.
   */
  @keyframes sprite {
    to {
      background-position-x: calc(var(--frame-w) * var(--avatar-scale) * var(--sprite-frames) * -1);
    }
  }
</style>
