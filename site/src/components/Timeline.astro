---
import TimelineEntry from './TimelineEntry.astro';
import { toLang, useTranslations } from '../i18n';
import { byDateDesc, getLocalized } from '../lib/content';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

const entries = (await getLocalized('timeline', lang)).sort(byDateDesc);
---

<section id="journey" class="journey" aria-labelledby="journey-heading">
  <header>
    <h2 id="journey-heading">{t('journey.heading')}</h2>
    <p>{t('journey.intro')}</p>
  </header>

  <ol class="entries">
    {entries.map((item, i) => (
      <TimelineEntry item={item} open={i === 0} />
    ))}
  </ol>
</section>

<style>
  .journey {
    padding-block: var(--space-7);
    --rail-width: 2rem;
  }

  @media (min-width: 48rem) {
    .journey {
      --rail-width: 4rem;
    }
  }

  header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-block-end: var(--space-6);
  }

  header p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .entries {
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
