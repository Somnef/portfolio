---
import { toLang, useTranslations } from '../i18n';

const t = useTranslations(toLang(Astro.currentLocale));
---

<p class="notice" role="note">
  {t('fallback.notice')}
</p>

<style>
  /* Informational, not an error: it uses the accent-dim border rather than
     anything alarming, and stays quiet enough not to outweigh the content
     it introduces. */
  .notice {
    border-inline-start: 2px solid var(--color-accent-dim);
    padding-inline-start: var(--space-3);
    margin-block-end: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    max-width: var(--measure);
  }
</style>
