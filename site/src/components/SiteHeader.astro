---
import { getRelativeLocaleUrl } from 'astro:i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { toLang, useTranslations } from '../i18n';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<header>
  <div class="inner">
    <a class="home" href={getRelativeLocaleUrl(lang, '/')}>
      {t('site.title')}
    </a>
    <nav aria-label={t('nav.label')}>
      <ul>
        <li>
          <a href={`${getRelativeLocaleUrl(lang, '/')}#journey`}>{t('nav.journey')}</a>
        </li>
        <li>
          <a href={getRelativeLocaleUrl(lang, '/projects/')}>{t('nav.projects')}</a>
        </li>
      </ul>
    </nav>

    <LanguageSwitcher />
  </div>
</header>

<style>
  header {
    border-block-end: var(--border-width) solid var(--color-divider);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
    max-width: var(--width-wide);
    margin-inline: auto;
    padding: var(--space-4) var(--space-5);
  }

  .home {
    font-family: var(--font-mono);
    font-weight: var(--weight-strong);
    color: var(--color-text);
    text-decoration: none;
  }

  .home:hover {
    color: var(--color-accent);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  nav a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-accent);
  }

  /* On a narrow screen the nav drops to its own row rather than squeezing
     the name and the language switcher. */
  @media (max-width: 30rem) {
    nav {
      order: 3;
      flex-basis: 100%;
    }
  }
</style>
