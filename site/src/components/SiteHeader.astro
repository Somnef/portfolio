---
import { getRelativeLocaleUrl } from 'astro:i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { toLang, useTranslations } from '../i18n';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<header>
  <div class="inner">
    <a class="home" href={getRelativeLocaleUrl(lang, '/')}>
      {t('site.title')}
    </a>
    <!-- Section links are added as their pages land, so the link checker
         never has a dead target to find. -->
    <LanguageSwitcher />
  </div>
</header>

<style>
  header {
    border-block-end: var(--border-width) solid var(--color-divider);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
    max-width: var(--width-wide);
    margin-inline: auto;
    padding: var(--space-4) var(--space-5);
  }

  .home {
    font-family: var(--font-mono);
    font-weight: var(--weight-strong);
    color: var(--color-text);
    text-decoration: none;
  }

  .home:hover {
    color: var(--color-accent);
  }
</style>
