---
import CvDownload from './CvDownload.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import ExternalLink from './ExternalLink.astro';
import { site } from '../config/site';
import { toLang, useTranslations } from '../i18n';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer>
  <div class="inner">
    <span>
      © {year} {t('site.title')}
    </span>
    <span class="links">
      <a href={getRelativeLocaleUrl(lang, '/contact/')}>{t('nav.contact')}</a>
      <CvDownload />
      <ExternalLink href={site.github} rel="me">
        GitHub
      </ExternalLink>
    </span>
  </div>
</footer>

<style>
  footer {
    border-block-start: var(--border-width) solid var(--color-divider);
    margin-block-start: var(--space-9);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: space-between;
    max-width: var(--width-wide);
    margin-inline: auto;
    padding: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
</style>
