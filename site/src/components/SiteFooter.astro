---
import { toLang, useTranslations } from '../i18n';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer>
  <div class="inner">
    <span>
      © {year} {t('site.title')}
    </span>
    <a href="https://github.com/Somnef" rel="me">
      GitHub
    </a>
  </div>
</footer>

<style>
  footer {
    border-block-start: var(--border-width) solid var(--color-divider);
    margin-block-start: var(--space-9);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: space-between;
    max-width: var(--width-wide);
    margin-inline: auto;
    padding: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
