---
import WritingIndex from '../../components/WritingIndex.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { toLang, useTranslations } from '../../i18n';

const t = useTranslations(toLang(Astro.currentLocale));
---

<BaseLayout title={`${t('writing.heading')} — ${t('site.title')}`} description={t('writing.intro')}>
  <div class="wrap">
    <WritingIndex />
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--width-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }
</style>
