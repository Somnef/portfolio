---
import type { GetStaticPaths } from 'astro';
import WritingIndex from '../../../components/WritingIndex.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { defaultLang, useTranslations } from '../../../i18n';
import { collectTypes, getLocalized, type Localized } from '../../../lib/content';

/*
 * A real page per type, so filtering by type works with scripting off and each
 * view is linkable and indexable. Types with no posts generate no page.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getLocalized('writing', defaultLang);
  return collectTypes(posts).map(({ type }) => ({
    params: { type },
    props: { posts: posts.filter((p) => p.entry.data.type === type), type },
  }));
};

interface Props {
  posts: Localized<'writing'>[];
  type: 'tutorial' | 'article' | 'note';
}

const { posts, type } = Astro.props;
const t = useTranslations(defaultLang);
const label = t(`writing.type.${type}` as 'writing.type.note');
---

<BaseLayout title={`${label} — ${t('writing.heading')}`} description={t('writing.intro')}>
  <div class="wrap">
    <WritingIndex posts={posts} eyebrow={t('writing.ofType')} heading={label} activeType={type} />
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--width-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }
</style>
