---
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { toLang, useTranslations } from '../i18n';

const t = useTranslations(toLang(Astro.currentLocale));
---

<BaseLayout title={`${t('site.title')} — ${t('site.role')}`} description={t('site.tagline')}>
  <div class="wrap">
    <Hero />
    <Timeline />
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--width-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }
</style>
