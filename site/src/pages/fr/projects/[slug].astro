---
import type { GetStaticPaths } from 'astro';
import ProjectDetail from '../../../components/ProjectDetail.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalized, type Localized } from '../../../lib/content';

// Same slugs as English: an untranslated project still gets its French URL,
// rendering the English body with a notice rather than 404ing.
export const getStaticPaths: GetStaticPaths = async () => {
  const items = await getLocalized('projects', 'fr');
  return items
    .filter((item) => item.entry.data.detailPage)
    .map((item) => ({ params: { slug: item.slug }, props: { item } }));
};

interface Props {
  item: Localized<'projects'>;
}

const { item } = Astro.props;
---

<BaseLayout title={item.entry.data.title} description={item.entry.data.summary}>
  <div class="wrap">
    <ProjectDetail item={item} />
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--width-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }
</style>
