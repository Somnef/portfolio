---
import type { GetStaticPaths } from 'astro';
import WritingIndex from '../../../../components/WritingIndex.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../../i18n';
import { collectTags, getLocalized, tagSlug, type Localized } from '../../../../lib/content';

/* One page per tag, for the same reason as the type pages. */
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getLocalized('writing', 'fr');
  return collectTags(posts).map(({ tag, slug }) => ({
    params: { tag: slug },
    props: { posts: posts.filter((p) => p.entry.data.tags.some((x) => tagSlug(x) === slug)), tag },
  }));
};

interface Props {
  posts: Localized<'writing'>[];
  tag: string;
}

const { posts, tag } = Astro.props;
const t = useTranslations('fr');
---

<BaseLayout title={`#${tag} — ${t('writing.heading')}`} description={t('writing.intro')}>
  <div class="wrap">
    <WritingIndex
      posts={posts}
      eyebrow={t('writing.taggedWith')}
      heading={`#${tag}`}
      activeTag={tagSlug(tag)}
    />
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--width-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }
</style>
