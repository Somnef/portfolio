---
import type { GetStaticPaths } from 'astro';
import PostPage from '../../../components/PostPage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalized, type Localized } from '../../../lib/content';

// Drafts are excluded from production by getLocalized, so no page is
// generated for them in a production build.
export const getStaticPaths: GetStaticPaths = async () => {
  const items = await getLocalized('writing', 'fr');
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
};

interface Props {
  item: Localized<'writing'>;
}

const { item } = Astro.props;
---

<BaseLayout title={item.entry.data.title} description={item.entry.data.description}>
  <div class="wrap">
    <PostPage item={item} />
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--width-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }
</style>
