---
import NotFound from '../components/NotFound.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { toLang, useTranslations } from '../i18n';

const t = useTranslations(toLang(Astro.currentLocale));
---

<BaseLayout
  title={`${t('notFound.title')} — ${t('site.title')}`}
  description={t('notFound.body')}
  noindex
>
  <div class="wrap">
    <NotFound />
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--width-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }
</style>
