---
import ProjectsIndex from '../../components/ProjectsIndex.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { toLang, useTranslations } from '../../i18n';

const t = useTranslations(toLang(Astro.currentLocale));
---

<BaseLayout
  title={`${t('projects.heading')} — ${t('site.title')}`}
  description={t('projects.intro')}
>
  <div class="wrap">
    <ProjectsIndex />
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--width-wide);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }
</style>
