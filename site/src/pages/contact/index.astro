---
import ContactForm from '../../components/ContactForm.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { toLang, useTranslations } from '../../i18n';

const t = useTranslations(toLang(Astro.currentLocale));
---

<BaseLayout title={`${t('contact.heading')} — ${t('site.title')}`} description={t('contact.intro')}>
  <section class="contact" aria-labelledby="contact-heading">
    <header class="intro">
      <h1 id="contact-heading">{t('contact.heading')}</h1>
      <p>{t('contact.intro')}</p>
    </header>
    <ContactForm />
  </section>
</BaseLayout>

<style>
  .contact {
    max-width: var(--width-wide);
    margin-inline: auto;
    padding: var(--space-7) var(--space-5) var(--space-8);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-block-end: var(--space-7);
  }

  .intro p {
    color: var(--color-text-muted);
  }
</style>
