# Site build configuration. Copy to .env (git-ignored) only to override.

# Turnstile site key (public). Unset, the build uses Cloudflare's dummy key
# 1x00000000000000000000AA (always passes), which pairs with the dummy
# secret the local contact API uses. Other dummies, to see the failures:
#   2x00000000000000000000AB   always blocks
#   3x00000000000000000000FF   forces an interactive challenge
# PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
